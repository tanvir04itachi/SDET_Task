          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in as an admin and stores the token in `{{adminToken}}`.\n\n⚠️ This user must already exist and be promoted to admin, e.g.:\n```sql\nUPDATE users SET role = 'admin' WHERE email = 'admin@example.com';\n```\nUpdate the `adminEmail` / `adminPassword` collection variables to match your real admin account before running this request."
          },
          "response": []
        }
      ]
    },
