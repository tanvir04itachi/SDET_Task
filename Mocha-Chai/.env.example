# Base URL of the running dmoney-transaction-api server
BASE_URL=http://localhost:5000

# Must match PARTNER_KEY in dmoney-transaction-api/.env — sent as the
# X-AUTH-SECRET-KEY header on every authenticateJWT-protected request.
SECRET_KEY=ROADTOSDET

# Must match DEFAULT_OTP in dmoney-transaction-api/.env — used with the
# ?env=dev bypass on POST /user/verify-otp so tests never need a real OTP.
DEFAULT_OTP=1234

# Pre-seeded SYSTEM account credentials (see dmoney-transaction-api/sequelizeModel/Users.js)
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234

# Pre-seeded Admin account credentials
ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=1234
