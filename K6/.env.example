# DMoney API
BASE_URL=http://localhost:5000
SECRET_KEY=<PARTNER_KEY from dmoney-transaction-api/.env>
DEFAULT_OTP=<dev OTP>

# Pre-seeded privileged accounts (used only by setup/seed.js)
SYSTEM_EMAIL=<system account email>
SYSTEM_PASSWORD=<system account password>
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<admin password>

# Local MySQL (used only by setup/prepare-db.js and setup/restore-db.js)
DB_HOST=localhost
DB_NAME=dmoneydb
DB_USER=root
DB_PASSWORD=<password>
